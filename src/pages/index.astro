---
import CtaBand from '../components/CtaBand.astro';
import Fill from '../components/Fill.astro';
import GoogleReviews from '../components/GoogleReviews.astro';
import Hero from '../components/Hero.astro';
import ServiceCard from '../components/ServiceCard.astro';
import SiteImage from '../components/SiteImage.astro';
import TrustList from '../components/TrustList.astro';
import { services } from '../data/services';
import { site } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import { professionalSchema } from '../utils/schema';

const origin = Astro.site!.origin;
---

<BaseLayout
  title={`Analisi e rieducazione visiva in ${site.regions.join(' e ')}`}
  description="Analisi visiva, rieducazione visiva (visual training) e potenziamento visivo sportivo per bambini, adulti e sportivi, in Marche e Umbria."
  jsonLd={[professionalSchema(origin)]}
>
  <Hero />

  <!-- Chi è -->
  <section class="section" aria-labelledby="chi-e">
    <div class="container split split--tablet about" style="--split: minmax(0, 1.3fr) minmax(0, 0.8fr); --split-align: center">
      <div class="about__text">
        <p class="eyebrow">Chi sono</p>
        <h2 id="chi-e">Mi occupo di come la vista viene usata ogni giorno</h2>
        <p>
          Sono <Fill value={site.name} />, optometrista, rieducatore visivo. Valuto le abilità visive e seguo
          percorsi di rieducazione e potenziamento visivo, soprattutto con i bambini, ma anche con adulti e sportivi.
        </p>
        <p>
          Ho lavorato in contesti diversi e, nelle Marche, sono stato l’unico ad avere uno studio dedicato
          esclusivamente a questa attività.
        </p>
        <p><a class="btn btn--secondary" href="/chi-sono/">Scopri il mio percorso</a></p>
      </div>
      <SiteImage name="professionista" class="about__photo" />
    </div>
  </section>

  <!-- Servizi -->
  <section class="section section--sand" aria-labelledby="servizi">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Servizi</p>
        <h2 id="servizi">I servizi, per situazioni diverse</h2>
        <p class="lead">Dalla valutazione delle abilità visive al percorso vero e proprio, fino al controllo a casa tua per chi fa fatica a spostarsi.</p>
      </div>
      <div class="service-quad">
        {services.map((service, i) => <ServiceCard service={service} index={i + 1} />)}
      </div>
    </div>
  </section>

  <!-- Perché affidarsi -->
  <section class="section" aria-labelledby="perche">
    <div class="container split" style="--split: minmax(0, 1fr) minmax(0, 2fr)">
      <div class="section-head trust-head">
        <p class="eyebrow">Perché affidarsi</p>
        <h2 id="perche">Esperienza, formazione e un lavoro condiviso con altri professionisti</h2>
      </div>
      <TrustList />
    </div>
  </section>

  <!-- Recensioni -->
  <section class="section section--dark on-dark" aria-labelledby="recensioni">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Recensioni</p>
        <h2 id="recensioni">Cosa dicono di me su Google</h2>
      </div>
      <GoogleReviews limit={3} showGoogleLink={false} />
      <p class="reviews-cta">
        <a class="btn btn--light" href="/recensioni/">Leggi tutte le recensioni</a>
      </p>
    </div>
  </section>

  <!-- Per i professionisti -->
  <section class="section section--sand" aria-labelledby="professionisti">
    <div class="container split pro" style="--split: minmax(0, 1.2fr) minmax(0, 1fr); --split-align: center">
      <div>
        <p class="eyebrow">Per i professionisti</p>
        <h2 id="professionisti"><span class="fit-text">Se lavori con i bambini come logopedista, psicologo o <span class="nowrap">neuropsicomotricista</span></span></h2>
        <p class="lead">
          Una parte importante delle famiglie che seguo mi viene indirizzata da altri professionisti. Nella pagina
          dedicata trovi come lavoro e come contattarmi.
        </p>
        <p><a class="btn btn--primary" href="/professionisti/">Vai alla pagina per i professionisti</a></p>
      </div>
      <div class="pro-network">
        <p class="pro-network__eyebrow">Collaborazione</p>
        <p class="pro-network__lead">Una rete di professionisti attorno al bambino</p>
        <ol class="pro-network__list" aria-label="Professionisti a cui è rivolta la pagina">
          <li>
            <span class="pro-network__index">01</span>
            <span class="pro-network__name">Logopedisti</span>
          </li>
          <li>
            <span class="pro-network__index">02</span>
            <span class="pro-network__name">Psicologi</span>
          </li>
          <li>
            <span class="pro-network__index">03</span>
            <span class="pro-network__name">Neuropsicomotricisti</span>
          </li>
          <li>
            <span class="pro-network__index">04</span>
            <span class="pro-network__name">Altri professionisti</span>
          </li>
        </ol>
      </div>
    </div>
  </section>

  <CtaBand
    title="Vuoi capire se questo percorso può essere adatto?"
    text="Scrivimi su WhatsApp descrivendo la situazione: valuterò se questo percorso è adatto."
  />
</BaseLayout>

<style>
  /* Le quattro schede dei servizi hanno lo stesso peso: una colonna su telefono, 2×2 da tablet in su.
     Dal tablet le righe interne delle schede (numero, titolo, descrizione, dettagli, link) sono condivise
     tra le schede della stessa riga (subgrid), così divisori e link restano allineati
     qualunque sia la lunghezza della descrizione. */
  .service-quad {
    display: grid;
    gap: 1.25rem;
  }

  /* Il badge ("Il percorso più frequente", "A domicilio") resta, ma non colora la scheda:
     bordo e sfondo sono quelli di tutte le altre */
  .service-quad :global(.service-card--note:not(:hover):not(:focus-within)) {
    background: var(--color-surface);
    border-color: var(--color-border);
  }

  /* Schede molto strette (telefoni a 320 px): il badge non sta più accanto al numero, va sotto di esso */
  @container (max-width: 19rem) {
    .service-quad :global(.service-card__note) {
      position: static;
      align-self: flex-start;
      margin-top: 0.75rem;
    }
  }

  @media (min-width: 48rem) {
    .service-quad {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 1.25rem;
      row-gap: 0;
    }

    .service-quad > :global(.service-cell) {
      display: grid;
      grid-row: span 5;
      grid-template-rows: subgrid;
      /* Due colonne: la scheda resta sempre in verticale */
      container-type: normal;
    }

    .service-quad > :global(.service-cell:nth-child(n + 3)) {
      margin-top: 1.25rem;
    }

    .service-quad :global(.service-card) {
      display: grid;
      grid-row: 1 / -1;
      grid-template-rows: subgrid;
      row-gap: 0;
    }

    .service-quad :global(.service-card__facts) {
      align-content: start;
    }

    .service-quad :global(.service-card__more) {
      justify-self: start;
      align-self: end;
    }
  }

  .about__text > * + * {
    margin-top: 1.1rem;
  }

  .about__text .eyebrow {
    margin-bottom: 0;
  }

  .about__text h2 {
    margin-top: 1rem;
  }

  .about__text p:last-child {
    margin-top: 1.75rem;
  }

  .about :global(.about__photo) {
    width: 100%;
    max-width: 18rem;
  }

  .trust-head {
    margin-bottom: 0;
  }

  .reviews-cta {
    margin-top: 2.25rem;
  }

  .pro > div > * + * {
    margin-top: 1.1rem;
  }

  .pro > div > .lead + p {
    margin-top: 1.75rem;
  }

  /* Rete di collaborazione: composizione editoriale al posto dei tag/pill
     (eyebrow + breve frase + elenco numerato con divisori sottili, sullo
     stesso principio del bordo di TrustList ma in versione più raccolta). */
  .pro-network__eyebrow {
    margin: 0 0 0.6rem;
    font-family: var(--font-heading);
    font-size: var(--text-label);
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--color-primary);
  }

  .pro-network__lead {
    margin: 0 0 1.5rem;
    max-width: 20rem;
    font-family: var(--font-heading);
    font-size: 1.1875rem;
    font-weight: 500;
    line-height: 1.35;
    color: var(--color-text);
  }

  .pro-network__list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 2px solid var(--color-text);
  }

  .pro-network__list li {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding-block: 0.9rem;
    border-bottom: 1px solid var(--color-border);
    transition: border-color 0.25s var(--ease);
  }

  .pro-network__index {
    flex: none;
    width: 1.75rem;
    font-family: var(--font-heading);
    font-size: var(--text-label);
    font-weight: 600;
    letter-spacing: 0.03em;
    color: var(--color-text-muted);
    transition: color 0.25s var(--ease);
  }

  .pro-network__name {
    font-family: var(--font-heading);
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--color-text);
    transition: color 0.25s var(--ease), transform 0.25s var(--ease);
  }

  .pro-network__list li:hover {
    border-bottom-color: var(--color-primary);
  }

  .pro-network__list li:hover .pro-network__index {
    color: var(--color-primary);
  }

  .pro-network__list li:hover .pro-network__name {
    color: var(--color-primary-dark);
    transform: translateX(3px);
  }

  @media (prefers-reduced-motion: reduce) {
    .pro-network__list li,
    .pro-network__index,
    .pro-network__name {
      transition: none;
    }
  }

  @media (min-width: 48rem) {
    .about :global(.about__photo) {
      justify-self: end;
      max-width: none;
    }
  }

  @media (min-width: 64rem) {

    .trust-head {
      position: sticky;
      top: calc(var(--header-h) + 2rem);
    }

  }
</style>
