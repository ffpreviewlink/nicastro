---
import ContactForm from '../components/ContactForm.astro';
import Fill from '../components/Fill.astro';
import Icon from '../components/Icon.astro';
import PageIntro from '../components/PageIntro.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { site } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatAddress, formatWhatsappNumber } from '../utils/format';
import { hasValue } from '../utils/placeholder';
import { professionalSchema } from '../utils/schema';
import { emailUrl, isWhatsappConfigured } from '../utils/whatsapp';

const origin = Astro.site!.origin;
---

<BaseLayout
  title="Contatti"
  description={`Come contattarmi: WhatsApp per prenotare o chiedere informazioni, oppure email. Ricevo presso ${site.locations[0]}.`}
  jsonLd={[professionalSchema(origin)]}
  floatingCta={false}
>
  <PageIntro eyebrow="Contatti" title="Scrivimi">
    Il modo più semplice per prenotare o chiedere informazioni è WhatsApp. Se preferisci, puoi scrivermi una email.
  </PageIntro>

  <section class="section" aria-label="Modi per contattarmi">
    <div class="container split contact" style="--split: minmax(0, 1fr) minmax(0, 1fr)">
      <div class="contact__channels">
        <div class="contact__whatsapp">
          <h2>WhatsApp</h2>
          <p>Scrivimi due righe: ti rispondo e concordiamo come procedere.</p>
          <WhatsAppButton size="lg" label="Contatta su WhatsApp" />
          {isWhatsappConfigured && <p class="small muted">Numero WhatsApp: {formatWhatsappNumber()}</p>}
        </div>

        <div>
          <h2 class="contact__h">Email e social</h2>
          <ul class="contact__list" role="list">
            <li>
              <Icon name="mail" />
              {
                hasValue(site.email) ? (
                  <a href={emailUrl()}>{site.email}</a>
                ) : (
                  <Fill value={site.email} />
                )
              }
            </li>
            {
              hasValue(site.phone) && (
                <li>
                  <Icon name="phone" />
                  <a href={`tel:${site.phone.replace(/[^\d+]/g, '')}`}>{site.phone}</a>
                </li>
              )
            }
            {
              hasValue(site.social.facebook) && (
                <li>
                  <Icon name="facebook" />
                  <a href={site.social.facebook} target="_blank" rel="noopener noreferrer">
                    Facebook<span class="visually-hidden"> (si apre in una nuova scheda)</span>
                  </a>
                </li>
              )
            }
          </ul>
        </div>

        <div>
          <h2 class="contact__h">Dove ricevo</h2>
          <p>
            Per sapere come fissare un appuntamento, scrivimi su WhatsApp.
          </p>
          <ul class="contact__list" role="list">
            {
              site.locations.map((place) => (
                <li>
                  <Icon name="pin" />
                  <Fill value={place} />
                </li>
              ))
            }
          </ul>
        </div>

        <p class="small muted">
          <Fill value={site.businessName} /> · {formatAddress()} · P.IVA <Fill value={site.vatId} />
        </p>
      </div>

      <div class="contact__form">
        <h2>Preferisci scrivere una email?</h2>
        <p class="muted">Compila il modulo: bastano nome, un recapito e il messaggio.</p>
        <ContactForm />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact__channels {
    display: grid;
    gap: 2.25rem;
  }

  .contact h2 {
    font-size: var(--text-h3);
  }

  .contact__whatsapp {
    display: grid;
    gap: 1rem;
    justify-items: start;
    padding: 1.75rem 1.5rem;
    border-radius: var(--radius-l);
    background: var(--color-primary-wash);
    border: 1px solid var(--color-primary);
  }

  .contact__h {
    margin-bottom: 0.75rem;
  }

  .contact__channels p + .contact__list {
    margin-top: 0.75rem;
  }

  .contact__list {
    display: grid;
    gap: 0.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .contact__list li {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    min-height: var(--touch);
  }

  .contact__list a {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch);
  }

  .contact__list :global(svg) {
    flex: none;
    width: 1.25rem;
    height: 1.25rem;
    color: var(--color-primary);
  }

  .contact__form {
    padding: 1.75rem 1.5rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-l);
    background: var(--color-surface);
  }

  .contact__form > p {
    margin-top: 0.5rem;
    margin-bottom: 1.5rem;
  }

  @media (min-width: 30rem) {
    .contact__whatsapp,
    .contact__form {
      padding: 2rem;
    }
  }
</style>
