---
/**
 * Controllo visivo a domicilio nella griglia di /servizi/: la quarta scheda e, subito sotto la griglia,
 * il blocco con prezzo, punti e pulsanti. Nome, prezzo, sintesi, destinatari e messaggio WhatsApp
 * vengono dal servizio `controllo-visivo-a-domicilio`, punti ed etichette da `homeVisit`
 * (src/data/services.ts).
 *
 * La scheda usa le stesse classi `service-card*` e la stessa struttura delle altre tre (numero,
 * titolo, descrizione, righe informative, link): l'aspetto comune è definito nella pagina
 * (src/pages/servizi/index.astro). Il numero «04» è generato dal CSS.
 * Il blocco sotto la griglia (`visit-extra`) è un secondo elemento della griglia, a tutta larghezza.
 */
import Icon from './Icon.astro';
import WhatsAppButton from './WhatsAppButton.astro';
import { formatPrice, getService, homeVisit } from '../data/services';

const service = getService(homeVisit.slug);
const price = formatPrice(service);
---

<div class="service-cell" id={homeVisit.anchor}>
  <article class="service-card service-card--visit" aria-labelledby="domicilio-title">
    <p class="service-card__index" aria-hidden="true"></p>

    <h2 class="service-card__title" id="domicilio-title">{service.name}</h2>

    <p class="service-card__summary">{service.summary}</p>

    <dl class="service-card__facts">
      <div>
        <dt>Per chi</dt>
        <dd>{service.audience}</dd>
      </div>
      <div>
        <dt>Costo</dt>
        <dd>
          <strong>{price.main}</strong>
          {price.detail && <span> {price.detail}</span>}
        </dd>
      </div>
    </dl>

    <p class="service-card__more">
      <a class="link-arrow" href={service.path}>
        Scopri come funziona <Icon name="arrow" />
      </a>
    </p>
  </article>
</div>

<div class="visit-extra">
  <div class="visit-price">
    <span class="visit-price__icon"><Icon name="home" /></span>
    <div>
      <p class="visit-price__amount">{service.price!.amount} €</p>
      <p class="visit-price__label">{homeVisit.priceLabel}</p>
    </div>
  </div>

  <ul class="checklist visit-points" role="list">
    {homeVisit.points.map((point) => <li>{point}</li>)}
  </ul>

  <div class="cta-row visit-cta" data-cta>
    <a class="btn btn--primary" href="/contatti/">Richiedi informazioni</a>
    <WhatsAppButton variant="secondary" message={service.whatsappMessage} label="Scrivimi su WhatsApp" />
  </div>
</div>

<style>
  /* Blocco sotto le schede: filetti, nessuno sfondo né riquadro, perché non sia una quinta scheda */
  .visit-extra {
    grid-column: 1 / -1;
    display: grid;
    gap: 1.25rem 2.5rem;
    padding-block: 1.5rem;
    border-block: 1px solid var(--color-border);
  }

  .visit-price {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }

  .visit-price__icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background: var(--color-primary-tint);
    color: var(--color-primary);
  }

  .visit-price__icon :global(svg) {
    width: 1.3rem;
    height: 1.3rem;
  }

  .visit-price__amount {
    font-family: var(--font-heading);
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.2;
  }

  .visit-price__label {
    margin-top: 0.15rem;
    font-size: var(--text-small);
    line-height: 1.4;
    color: var(--color-text-muted);
  }

  .visit-points {
    gap: 0.5rem;
    margin: 0;
  }

  .visit-cta {
    align-self: start;
  }

  @media (max-width: 30rem) {
    .visit-cta {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  /* Da laptop: prezzo | punti | pulsanti su una riga */
  @media (min-width: 64rem) {
    .visit-extra {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr) auto;
      align-items: center;
    }

    .visit-cta {
      flex-direction: column;
      align-items: stretch;
    }
  }
</style>
