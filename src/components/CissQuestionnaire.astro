---
/**
 * Questionario CISS interattivo, in una finestra modale: età → 15 domande (una per
 * schermata) → riepilogo modificabile → punteggio. Tutto avviene nel browser, in memoria.
 *
 * Qui c'è solo la struttura: il comportamento è in src/scripts/ciss.ts, domande e testi
 * in src/data/ciss.ts. Nel markup c'è UN solo pannello domanda: lo script ne cambia il testo
 * a ogni passo (stesse cinque risposte per tutte le domande, come nel PDF).
 *
 * Tutto il markup sta in un <template>: non pesa, non è indicizzato né letto dagli screen reader
 * su ogni pagina; lo script lo inserisce nella pagina alla prima apertura.
 */
import {
  cissInstructions,
  cissName,
  cissOptions,
  cissQuestions,
  cissResult,
  cissSource,
} from '../data/ciss';
import { site } from '../data/site';
import { emailUrl } from '../utils/whatsapp';
import Icon from './Icon.astro';
import WhatsAppButton from './WhatsAppButton.astro';

---

<template data-ciss-template="questionnaire">
<dialog
  class="dialog ciss"
  id="ciss"
  aria-label={cissName}
  data-total={cissQuestions.length}
>
  <div class="dialog__frame">
    <div class="ciss__bar">
      <div class="ciss__progress" data-progress hidden aria-hidden="true">
        <span data-progress-fill></span>
      </div>
      <button class="dialog__close" type="button" data-ciss-exit aria-label="Chiudi il questionario">
        <Icon name="close" />
      </button>
    </div>

    <!-- 1 · Età -->
    <form class="ciss__screen" data-screen="age" novalidate>
      <div class="dialog__body">
        <h2 tabindex="-1" data-focus>Prima di iniziare</h2>
        <p class="lead">Per iniziare serve un solo dato: l’età.</p>

        <div class="field">
          <label class="field__label" for="ciss-age">Quanti anni ha la persona a cui si riferiscono le risposte?</label>
          <span class="field__hint" id="ciss-age-hint">Scrivi l’età in anni, per esempio 12.</span>
          <input
            class="field__control ciss__age"
            id="ciss-age"
            type="text"
            inputmode="numeric"
            pattern="[0-9]*"
            maxlength="3"
            autocomplete="off"
            aria-describedby="ciss-age-hint ciss-age-error"
            data-age
          />
          <p class="field__error" id="ciss-age-error" role="alert" hidden data-age-error></p>
        </div>

        <p class="small muted ciss__privacy">
          Le risposte restano sul tuo dispositivo: non vengono inviate né salvate.
        </p>

        <details class="ciss__source">
          <summary>Fonte del questionario</summary>
          <p class="small"><strong>{cissSource.title}</strong></p>
          {cissSource.credits.map((credit) => <p class="small">{credit}</p>)}
        </details>
      </div>
      <div class="dialog__actions">
        <button class="btn btn--secondary btn--lg" type="button" data-action="age-back">Indietro</button>
        <button class="btn btn--primary btn--lg" type="submit">Continua</button>
      </div>
    </form>

    <!-- 2 · Domanda (un solo pannello, riempito dallo script) -->
    <form class="ciss__screen" data-screen="question" hidden novalidate>
      <div class="dialog__body">
        <h2 class="ciss__counter" tabindex="-1" data-focus data-counter></h2>
        <p class="ciss__instructions" data-instructions>{cissInstructions}</p>

        <fieldset class="ciss__fieldset" aria-describedby="ciss-answer-error">
          <legend class="ciss__question" data-question></legend>
          <div class="ciss__options">
            {
              cissOptions.map((option) => (
                <div class="ciss__option">
                  <input type="radio" name="ciss-answer" id={`ciss-option-${option.value}`} value={option.value} />
                  <label for={`ciss-option-${option.value}`}>{option.label}</label>
                </div>
              ))
            }
          </div>
        </fieldset>
        <p class="field__error" id="ciss-answer-error" role="alert" hidden data-answer-error>
          Scegli una risposta per continuare.
        </p>
      </div>
      <div class="dialog__actions">
        <button class="btn btn--secondary btn--lg" type="button" data-action="question-back">Indietro</button>
        <button class="btn btn--primary btn--lg" type="submit">Continua</button>
      </div>
    </form>

    <!-- 3 · Riepilogo modificabile -->
    <form class="ciss__screen" data-screen="review" hidden novalidate>
      <div class="dialog__body">
        <h2 tabindex="-1" data-focus>Controlla le tue risposte</h2>
        <p class="lead">Puoi modificare ogni risposta prima di vedere il punteggio.</p>
        <ol class="ciss__summary" role="list" data-summary="review"></ol>
        <p class="field__error" role="alert" hidden data-review-error>Manca almeno una risposta: completa il questionario per vedere il punteggio.</p>
      </div>
      <div class="dialog__actions">
        <button class="btn btn--secondary btn--lg" type="button" data-action="review-back">Indietro</button>
        <button class="btn btn--primary btn--lg" type="submit">Vedi il punteggio</button>
      </div>
    </form>

    <!-- 4 · Punteggio -->
    <section class="ciss__screen" data-screen="result" hidden>
      <div class="dialog__body">
        <p class="eyebrow">Fine del questionario</p>
        <h2 tabindex="-1" data-focus>{cissResult.title}</h2>

        <div class="ciss__score" data-score-box>
          <p class="ciss__score-ring"><strong data-score></strong></p>
          <div class="ciss__score-text">
            <p class="ciss__score-label">{cissResult.scoreLabel}</p>
            <!-- Compare solo se la fascia è approvata: si vede solo il colore, il testo è per gli screen reader -->
            <p class="visually-hidden ciss__score-band" data-score-band hidden>
              <span data-score-band-label></span>
            </p>
          </div>
        </div>

        <p class="note ciss__note">{cissResult.note}</p>

        <div class="ciss__contact-box">
          <h3>{cissResult.contact.title}</h3>
          <p>{cissResult.contact.text(site.businessName)}</p>
          <div class="cta-row ciss__contact">
            <WhatsAppButton message={cissResult.contact.whatsappMessage} label="Contatta lo studio su WhatsApp" />
            <a class="btn btn--secondary" href={emailUrl(cissResult.contact.emailSubject)}>Scrivi via email</a>
          </div>
        </div>

        <h3 class="ciss__summary-title">Riepilogo delle risposte</h3>
        <ol class="ciss__summary" role="list" data-summary="result"></ol>

        <details class="ciss__source">
          <summary>Fonte del questionario</summary>
          <p class="small"><strong>{cissSource.title}</strong></p>
          {cissSource.credits.map((credit) => <p class="small">{credit}</p>)}
        </details>
      </div>
      <div class="dialog__actions">
        <button class="btn btn--secondary btn--lg" type="button" data-action="result-edit">Modifica le risposte</button>
        <button class="btn btn--secondary btn--lg" type="button" data-action="result-restart">Ricomincia</button>
      </div>
    </section>
  </div>

  <!-- Riga del riepilogo (clonata dallo script, così eredita gli stili di questo componente) -->
  <template data-summary-row>
    <li class="ciss__row">
      <span class="ciss__row-number" data-row-number></span>
      <div class="ciss__row-text">
        <p class="ciss__row-question" data-row-question></p>
        <p class="ciss__row-answer"><span data-row-answer></span><span class="ciss__row-points" data-row-points></span></p>
      </div>
      <button class="link-button ciss__row-edit" type="button" data-row-edit>Modifica</button>
    </li>
  </template>
</dialog>

<!-- Conferme (uscire, ricominciare): finestra propria, sopra il questionario -->
<dialog class="dialog ciss-confirm" id="ciss-confirm" aria-labelledby="ciss-confirm-title" aria-describedby="ciss-confirm-text">
  <form method="dialog" class="ciss-confirm__frame">
    <h2 id="ciss-confirm-title" data-confirm-title></h2>
    <p id="ciss-confirm-text" data-confirm-text></p>
    <div class="ciss-confirm__actions">
      <button class="btn btn--primary" value="cancel" autofocus data-confirm-cancel></button>
      <button class="btn btn--secondary" value="confirm" data-confirm-ok></button>
    </div>
  </form>
</dialog>
</template>

<style>
  /* --- Cornice ------------------------------------------------------------ */
  .ciss {
    --dialog-width: 42rem;
  }

  .ciss__bar {
    flex: none;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    justify-content: flex-end;
    padding: 0.5rem 0.5rem 0 1.25rem;
  }

  .ciss__progress {
    flex: 1;
    height: 0.5rem;
    border-radius: 999px;
    background: var(--color-bg-sand-deep);
    overflow: hidden;
  }

  .ciss__progress span {
    display: block;
    height: 100%;
    width: 0;
    border-radius: inherit;
    background: var(--color-primary);
    transition: width 0.35s var(--ease);
  }

  .ciss__screen {
    flex: 1 1 auto;
    min-height: 0;
    display: flex;
    flex-direction: column;
    margin: 0;
  }

  .ciss__screen > .dialog__body {
    flex: 1 1 auto;
    min-height: 0;
    padding: 0.75rem 1.25rem 1.5rem;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .ciss__screen > .dialog__body > * + * {
    margin-top: 1rem;
  }

  .ciss__screen h2 {
    font-size: clamp(1.4rem, 1.2rem + 1vw, 1.75rem);
  }

  .ciss__screen h2:focus {
    outline: none;
  }

  .ciss__screen .lead {
    font-size: 1rem;
  }

  .dialog__actions {
    flex: none;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
    gap: 0.75rem;
    padding: 0.9rem 1.25rem calc(0.9rem + env(safe-area-inset-bottom));
    border-top: 1px solid var(--color-border);
    background: var(--color-surface);
  }

  .dialog__actions .btn {
    padding-inline: 0.75rem;
  }

  /* Dopo il riepilogo (due pulsanti equivalenti) le colonne sono uguali */
  [data-screen='result'] > .dialog__actions {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  /* --- Età ---------------------------------------------------------------- */
  .ciss__age {
    max-width: 8rem;
    font-size: 1.25rem;
    font-weight: 600;
    text-align: center;
  }

  .ciss__privacy {
    padding-left: 0.9rem;
    border-left: 3px solid var(--color-primary-tint);
  }

  .ciss__source {
    font-size: var(--text-small);
    color: var(--color-text-muted);
  }

  .ciss__source summary {
    display: flex;
    align-items: center;
    min-height: var(--touch);
    cursor: pointer;
    font-weight: 500;
  }

  .ciss__source p {
    margin-top: 0.5rem;
    max-width: none;
  }

  /* --- Domanda ------------------------------------------------------------ */
  .ciss__counter {
    font-family: var(--font-heading);
    font-size: var(--text-label) !important;
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--color-primary);
  }

  .ciss__instructions {
    padding: 0.75rem 1rem;
    border-radius: var(--radius-m);
    background: var(--color-primary-wash);
    color: var(--color-text-muted);
    font-size: var(--text-small);
    max-width: none;
  }

  .ciss__fieldset {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .ciss__question {
    display: block;
    width: 100%;
    margin-bottom: 1.1rem;
    padding: 0;
    font-family: var(--font-heading);
    font-size: clamp(1.2rem, 1.1rem + 0.8vw, 1.5rem);
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: var(--color-text);
    text-wrap: pretty;
  }

  .ciss__options {
    display: grid;
    gap: 0.5rem;
  }

  /* Il radio vero resta nel DOM (tastiera, screen reader): si vede l'etichetta */
  .ciss__option {
    position: relative;
  }

  .ciss__option input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }

  .ciss__option label {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    min-height: 3.1rem;
    padding: 0.4rem 1rem;
    border: 2px solid var(--color-border-strong);
    border-radius: var(--radius-m);
    background: var(--color-surface);
    font-family: var(--font-heading);
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.25;
    pointer-events: none;
    transition:
      background-color 0.18s var(--ease),
      border-color 0.18s var(--ease),
      box-shadow 0.18s var(--ease);
  }

  .ciss__option label::before {
    content: '';
    flex: none;
    width: 1.5rem;
    height: 1.5rem;
    border: 2px solid var(--color-border-strong);
    border-radius: 50%;
    background: var(--color-surface);
    transition:
      border-color 0.18s var(--ease),
      background-color 0.18s var(--ease),
      box-shadow 0.18s var(--ease);
  }

  @media (hover: hover) {
    .ciss__option:hover label {
      border-color: var(--color-primary);
      background: var(--color-primary-wash);
    }
  }

  .ciss__option input:checked + label {
    border-color: var(--color-primary);
    background: var(--color-primary-tint);
    color: var(--color-primary-dark);
  }

  .ciss__option input:checked + label::before {
    border-color: var(--color-primary);
    background: var(--color-primary);
    box-shadow: inset 0 0 0 4px var(--color-primary-tint);
  }

  .ciss__option input:focus-visible + label {
    outline: 3px solid var(--color-focus);
    outline-offset: 3px;
  }

  /* Dove c'è spazio le cinque risposte stanno in fila, come nelle colonne del PDF */
  @media (min-width: 42rem) {
    .ciss .ciss__options {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 0.5rem;
    }

    .ciss__option label {
      flex-direction: column;
      justify-content: center;
      gap: 0.6rem;
      min-height: 6rem;
      padding: 0.75rem 0.35rem;
      text-align: center;
      font-size: 1rem;
    }
  }

  /* --- Riepilogo ---------------------------------------------------------- */
  .ciss__summary {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-border);
  }

  .ciss__row {
    display: grid;
    grid-template-columns: 1.75rem minmax(0, 1fr) auto;
    gap: 0.25rem 0.75rem;
    align-items: start;
    padding: 0.8rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .ciss__row-number {
    font-family: var(--font-heading);
    font-weight: 600;
    color: var(--color-primary);
  }

  .ciss__row-question {
    max-width: none;
    font-size: var(--text-small);
    color: var(--color-text-muted);
  }

  .ciss__row-answer {
    margin-top: 0.15rem;
    font-weight: 600;
  }

  .ciss__row-points {
    margin-left: 0.5rem;
    font-weight: 400;
    font-size: var(--text-small);
    color: var(--color-text-muted);
  }

  .ciss__row-points:empty {
    display: none;
  }

  .ciss__row-edit {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch);
    margin-block: -0.6rem;
    padding-inline: 0.25rem;
    font-weight: 600;
  }

  /* --- Punteggio ---------------------------------------------------------- */
  /* Scheda chiara con un tono morbido della fascia: il colore sta nel cerchio, nello sfondo
     e nel numero (in una tinta scura leggibile). Il cerchio è sempre pieno: non è una
     barra di avanzamento, un numero più alto non è «più vicino a un traguardo». */
  .ciss__score {
    --tone: var(--color-primary-light);
    --tone-ink: var(--color-primary-dark);
    --tone-wash: var(--color-primary-wash);
    position: relative; /* ancora il testo .visually-hidden */
    display: flex;
    align-items: center;
    gap: 1.1rem;
    padding: 1.1rem 1.25rem;
    border: 1px solid color-mix(in srgb, var(--tone) 45%, var(--color-surface));
    border-radius: var(--radius-l);
    background: var(--tone-wash);
    color: var(--color-text);
  }

  .ciss__score[data-tone='red'] {
    --tone: #e5594b;
    --tone-ink: #a3231a;
    --tone-wash: #fdeeec;
  }

  .ciss__score[data-tone='yellow'] {
    --tone: #f2b21e;
    --tone-ink: #7a5200;
    --tone-wash: #fff6dd;
  }

  .ciss__score[data-tone='green'] {
    --tone: #3db57a;
    --tone-ink: #1b6b45;
    --tone-wash: #e7f6ee;
  }

  .ciss__score p {
    max-width: none;
  }

  .ciss__score-ring {
    flex: none;
    display: grid;
    place-items: center;
    width: 5.75rem;
    height: 5.75rem;
    border: 0.5rem solid var(--tone);
    border-radius: 50%;
    background: var(--color-surface);
    /* alone morbido attorno al cerchio */
    box-shadow: 0 0 0 0.45rem color-mix(in srgb, var(--tone) 22%, transparent);
    font-family: var(--font-heading);
    line-height: 1;
  }

  .ciss__score-ring strong {
    font-size: 2.4rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--tone-ink);
  }

  .ciss__score-label {
    font-family: var(--font-heading);
    font-size: var(--text-label);
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--tone-ink);
  }

  .ciss__score-band[hidden] {
    display: none;
  }

  @media (min-width: 30rem) {
    .ciss__score {
      gap: 1.5rem;
      padding: 1.4rem 1.75rem;
    }

    .ciss__score-ring {
      width: 6.75rem;
      height: 6.75rem;
    }

    .ciss__score-ring strong {
      font-size: 2.9rem;
    }
  }

  .ciss__contact-box {
    padding: 1.25rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-l);
    background: var(--color-surface);
  }

  .ciss__contact-box p {
    margin-top: 0.4rem;
  }

  .ciss__contact {
    margin-top: 1rem;
  }

  .ciss__summary-title {
    margin-top: 1.75rem !important;
    margin-bottom: 0.25rem;
  }

  @media (max-width: 30rem) {
    .ciss__contact {
      flex-direction: column;
      align-items: stretch;
    }
  }

  /* --- Conferme ----------------------------------------------------------- */
  .ciss-confirm {
    --dialog-width: 26rem;
  }

  .ciss-confirm__frame {
    padding: 1.5rem 1.25rem 1.25rem;
  }

  .ciss-confirm h2 {
    font-size: 1.3rem;
  }

  .ciss-confirm p {
    margin-top: 0.6rem;
  }

  .ciss-confirm__actions {
    display: grid;
    gap: 0.6rem;
    margin-top: 1.4rem;
  }

  @media (min-width: 30rem) {
    .ciss__bar {
      padding-left: 2rem;
    }

    .ciss__screen > .dialog__body {
      padding-inline: 2rem;
    }

    .dialog__actions {
      padding-inline: 2rem;
    }

    .ciss-confirm__frame {
      padding: 1.75rem 1.75rem 1.5rem;
    }

    .ciss-confirm__actions {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
