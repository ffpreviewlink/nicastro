---
/**
 * Recensioni Google reali, recuperate lato client dal nostro endpoint PHP
 * (public/api/google-reviews.php), che a sua volta interroga Google Places
 * API (New) e mantiene una cache server-side. Il browser non chiama mai
 * Google direttamente e non conosce alcuna chiave API. La pipeline dati
 * (Google → PHP → cache → questo componente) non va toccata da qui.
 *
 * Il sito resta statico e il collegamento a Google funziona ovunque (anche su GitHub
 * Pages, dove il PHP non gira): il riquadro con «Leggi le recensioni su Google» e
 * «Lascia una recensione» è HTML già pronto, senza JavaScript. Quando l'endpoint risponde
 * si aggiungono valutazione, numero di recensioni e carosello; altrimenti non compare
 * nulla di rotto né di finto — mai numeri, stelle o testi inventati.
 *
 * Presentazione: un blocco valutazione editoriale (non una "dashboard" di
 * statistiche) seguito da un carosello leggero, a scorrimento nativo
 * (overflow-x + scroll-snap, come il carosello del Hero) — niente librerie.
 */
import Icon from './Icon.astro';
import { manualReviews } from '../data/reviews';
import { site } from '../data/site';

interface Props {
  /** Numero massimo di recensioni da mostrare (default: tutte quelle restituite, fino a 5). */
  limit?: number;
  /** Millisecondi tra una recensione e la successiva; 0 = nessun cambio automatico. Default 20 secondi. */
  autoplay?: number;
}

const { limit, autoplay = 20000 } = Astro.props;
const { readUrl, writeUrl } = site.googleReviews;

// Recensioni inserite a mano (src/data/reviews.ts): servono finché l'endpoint live non risponde
const items = limit ? manualReviews.items.slice(0, limit) : manualReviews.items;
const summary = items.length ? manualReviews.summary : null;
const formatRating = (value: number) =>
  value.toLocaleString('it-IT', { minimumFractionDigits: 1, maximumFractionDigits: 1 });
const stars = (n: number) => Array.from({ length: n });
---

<div class="google-reviews" data-google-reviews data-limit={limit ?? ''} data-autoplay={autoplay}>
  <div class="reviews-rating">
    <div class="reviews-rating__main">
      <!-- Testo fisso; se Google risponde lo sostituiscono valutazione e numero di recensioni -->
      <div class="reviews-rating__info" data-google-reviews-info>
        {
          summary ? (
            <>
              <div class="reviews-rating__headline">
                <span class="reviews-rating__number">{formatRating(summary.rating)}</span>
                <span class="reviews-rating__stars" role="img" aria-label={`${formatRating(summary.rating)} stelle su 5`}>
                  {stars(Math.round(summary.rating)).map(() => <Icon name="star" />)}
                </span>
              </div>
              <p class="reviews-rating__caption">Basato su {summary.count} recensioni Google</p>
            </>
          ) : (
            <p class="reviews-rating__intro">
              Le recensioni sono scritte direttamente su Google da chi si è rivolto a me: le trovi lì, nella loro forma
              originale.
            </p>
          )
        }
      </div>
    </div>

    <div class="cta-row reviews-rating__actions">
      <a class="btn btn--primary" href={readUrl} target="_blank" rel="noopener noreferrer" data-google-reviews-link>
        Leggi le recensioni su Google
        <Icon name="arrow" />
        <span class="visually-hidden"> (si apre in una nuova scheda)</span>
      </a>
      <a class="btn btn--secondary" href={writeUrl} target="_blank" rel="noopener noreferrer">
        Lascia una recensione
        <span class="visually-hidden"> (si apre in una nuova scheda)</span>
      </a>
    </div>
  </div>

  <div class="reviews-carousel" data-carousel hidden={items.length === 0}>
    <ul class="reviews-carousel__track" data-track role="list">
      {
        /* Stesso markup e stesse classi di reviewMarkup() nello script (recensioni live) */
        items.map((review, index) => (
          <li class:list={['google-review', { 'is-active': index === 0 }]}>
            <figure class="google-review__figure">
              {review.rating && (
                <span class="google-review__stars" role="img" aria-label={`${review.rating} stelle su 5`}>
                  {stars(review.rating).map(() => <Icon name="star" />)}
                </span>
              )}
              <blockquote class="google-review__text google-review__text--full">
                {review.text.split(/\n\s*\n/).map((paragraph) => <p>{paragraph}</p>)}
              </blockquote>
              <figcaption class="google-review__author">
                <span class="google-review__avatar google-review__avatar--fallback" aria-hidden="true">
                  {review.author.trim().charAt(0).toUpperCase() || '?'}
                </span>
                <span class="google-review__author-info">
                  <span class="google-review__author-name">{review.author}</span>
                  <span class="google-review__author-sub">Recensione Google</span>
                </span>
              </figcaption>
              {review.url && (
                <p class="google-review__meta">
                  <a href={review.url} target="_blank" rel="noopener noreferrer nofollow ugc">
                    Leggi su Google
                    <span class="visually-hidden"> (si apre in una nuova scheda)</span>
                  </a>
                </p>
              )}
            </figure>
          </li>
        ))
      }
    </ul>

    <div class="reviews-carousel__nav" data-nav hidden={items.length < 2}>
      <button type="button" class="reviews-carousel__arrow" data-prev aria-label="Recensione precedente">
        <Icon name="arrow" class="reviews-carousel__arrow-icon reviews-carousel__arrow-icon--prev" />
      </button>
      <div class="reviews-carousel__dots" data-dots role="group" aria-label="Scegli la recensione"></div>
      <button type="button" class="reviews-carousel__arrow" data-next aria-label="Recensione successiva">
        <Icon name="arrow" class="reviews-carousel__arrow-icon" />
      </button>
    </div>
  </div>

  <!-- Contenuto opzionale (es. link a tutte le recensioni): compare solo se le recensioni ci sono davvero -->
  <div class="google-reviews__more" data-google-reviews-more hidden={items.length === 0}>
    <slot />
  </div>
</div>

<script>
  const STAR_SVG =
    '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="m12 2.8 2.9 5.9 6.5.9-4.7 4.6 1.1 6.5L12 17.6l-5.8 3.1 1.1-6.5-4.7-4.6 6.5-.9L12 2.8Z" /></svg>';

  const ESCAPE_MAP: Record<string, string> = {
    '&': '&amp;',
    '<': '&lt;',
    '>': '&gt;',
    '"': '&quot;',
    "'": '&#39;',
  };

  function escapeHtml(value: unknown): string {
    return String(value ?? '').replace(/[&<>"']/g, (char) => ESCAPE_MAP[char]);
  }

  /**
   * Verifica che un URI ricevuto dal nostro endpoint sia effettivamente HTTPS
   * prima di usarlo come href/src. Se non lo è, il valore viene scartato:
   * niente conversioni, niente fallback verso altri URL.
   */
  function isHttpsUrl(value: unknown): value is string {
    return typeof value === 'string' && /^https:\/\//i.test(value);
  }

  function starRow(rating: unknown): string {
    const n = Math.round(Math.max(0, Math.min(5, Number(rating) || 0)));
    return STAR_SVG.repeat(n);
  }

  function formatRating(value: unknown): string | null {
    if (typeof value !== 'number' || Number.isNaN(value)) return null;
    return value.toLocaleString('it-IT', { minimumFractionDigits: 1, maximumFractionDigits: 1 });
  }

  interface GoogleReview {
    authorName: string;
    authorPhotoUri: string | null;
    authorProfileUri: string | null;
    rating: number | null;
    text: string | null;
    translated: boolean;
    originalText: string | null;
    relativeTime: string | null;
    reviewUri: string | null;
  }

  interface GoogleReviewsPayload {
    available: boolean;
    name?: string;
    rating?: number | null;
    userRatingCount?: number | null;
    googleMapsUri?: string | null;
    reviews?: GoogleReview[];
  }

  function renderSummary(root: HTMLElement, data: GoogleReviewsPayload): void {
    const info = root.querySelector<HTMLElement>('[data-google-reviews-info]');
    const ratingText = formatRating(data.rating);

    // Dati letti da Google: i termini d'uso richiedono l'attribuzione testuale «Google Maps»
    const main = root.querySelector<HTMLElement>('.reviews-rating__main');
    if (main && !main.querySelector('.reviews-rating__badge')) {
      main.insertAdjacentHTML('afterbegin', '<p class="reviews-rating__badge">Google Maps</p>');
    }

    // Solo dati reali: senza una valutazione numerica resta il testo fisso
    if (info && ratingText) {
      const countText =
        typeof data.userRatingCount === 'number' ? `Basato su ${data.userRatingCount} recensioni Google` : '';
      info.innerHTML = `
        <div class="reviews-rating__headline">
          <span class="reviews-rating__number">${ratingText}</span>
          <span class="reviews-rating__stars" role="img" aria-label="${escapeHtml(ratingText)} stelle su 5">${starRow(data.rating)}</span>
        </div>
        ${countText ? `<p class="reviews-rating__caption">${countText}</p>` : ''}
      `;
    }

    // Il link ufficiale restituito da Google ha la precedenza su quello costruito dal Place ID
    const link = root.querySelector<HTMLAnchorElement>('[data-google-reviews-link]');
    if (link && isHttpsUrl(data.googleMapsUri)) link.href = data.googleMapsUri;
  }

  function reviewMarkup(review: GoogleReview): string {
    const photoUri = isHttpsUrl(review.authorPhotoUri) ? review.authorPhotoUri : null;
    const profileUri = isHttpsUrl(review.authorProfileUri) ? review.authorProfileUri : null;
    const reviewUri = isHttpsUrl(review.reviewUri) ? review.reviewUri : null;

    const avatar = photoUri
      ? `<img class="google-review__avatar" src="${escapeHtml(photoUri)}" alt="" width="40" height="40" loading="lazy" referrerpolicy="no-referrer" />`
      : `<span class="google-review__avatar google-review__avatar--fallback" aria-hidden="true">${escapeHtml(review.authorName.trim().charAt(0).toUpperCase() || '?')}</span>`;

    const authorName = profileUri
      ? `<a class="google-review__author-name" href="${escapeHtml(profileUri)}" target="_blank" rel="noopener noreferrer nofollow ugc">${escapeHtml(review.authorName)}</a>`
      : `<span class="google-review__author-name">${escapeHtml(review.authorName)}</span>`;

    const stars =
      typeof review.rating === 'number'
        ? `<span class="google-review__stars" role="img" aria-label="${review.rating} stelle su 5">${starRow(review.rating)}</span>`
        : '';

    // Recensione tradotta da Google: si mostra il testo tradotto, con un avviso
    // discreto e un pulsante per vedere l'originale, solo se davvero disponibile.
    const showOriginalToggle = review.translated && !!review.originalText;
    const text = review.text
      ? `<blockquote class="google-review__text">
          <p data-text-translated>${escapeHtml(review.text)}</p>
          ${showOriginalToggle ? `<p data-text-original hidden>${escapeHtml(review.originalText)}</p>` : ''}
        </blockquote>`
      : '';

    const translatedNotice = review.translated
      ? `<p class="google-review__translated">
          <span>Tradotto da Google</span>
          ${showOriginalToggle ? `<button type="button" class="google-review__toggle-original" data-toggle-original>Mostra originale</button>` : ''}
        </p>`
      : '';

    // La data compare già accanto al nome (autore-sub): qui solo il link alla fonte.
    const meta = reviewUri
      ? `<a href="${escapeHtml(reviewUri)}" target="_blank" rel="noopener noreferrer nofollow ugc">Leggi su Google</a>`
      : '';

    return `
      <li class="google-review">
        <figure class="google-review__figure">
          ${stars}
          ${text}
          ${translatedNotice}
          <figcaption class="google-review__author">
            ${avatar}
            <span class="google-review__author-info">
              ${authorName}
              <span class="google-review__author-sub">Recensione Google${review.relativeTime ? ` · ${escapeHtml(review.relativeTime)}` : ''}</span>
            </span>
          </figcaption>
          ${meta ? `<p class="google-review__meta">${meta}</p>` : ''}
        </figure>
      </li>
    `;
  }

  function bindOriginalToggle(track: HTMLElement): void {
    track.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-toggle-original]');
      if (!button) return;

      const figure = button.closest('.google-review__figure');
      const translatedEl = figure?.querySelector<HTMLElement>('[data-text-translated]');
      const originalEl = figure?.querySelector<HTMLElement>('[data-text-original]');
      if (!translatedEl || !originalEl) return;

      const showingOriginal = !originalEl.hidden;
      originalEl.hidden = showingOriginal;
      translatedEl.hidden = !showingOriginal;
      button.textContent = showingOriginal ? 'Mostra originale' : 'Mostra traduzione';
    });
  }

  // Un solo carosello attivo per riquadro: se le recensioni live sostituiscono quelle inserite
  // a mano, i vecchi ascoltatori e il timer vengono tolti (niente doppi click sulle frecce).
  const carouselControllers = new WeakMap<HTMLElement, AbortController>();

  /**
   * Carosello a una recensione per volta, a scorrimento nativo (overflow-x + scroll-snap,
   * come il Hero): nessuna libreria; swipe/trackpad nativi, frecce, puntini e tastiera in più.
   * Cambia da solo ogni `data-autoplay` ms, con le stesse regole della galleria foto: si ferma
   * col mouse sopra o col focus da tastiera, quando la pagina non è visibile o il carosello è
   * fuori schermo, e non parte con «riduci animazioni». Senza pulsante di pausa, come richiesto.
   */
  function setupCarousel(root: HTMLElement): void {
    carouselControllers.get(root)?.abort();
    const controller = new AbortController();
    carouselControllers.set(root, controller);
    const { signal } = controller;

    const carousel = root.querySelector<HTMLElement>('[data-carousel]');
    const track = root.querySelector<HTMLElement>('[data-track]');
    const nav = root.querySelector<HTMLElement>('[data-nav]');
    const prevBtn = root.querySelector<HTMLButtonElement>('[data-prev]');
    const nextBtn = root.querySelector<HTMLButtonElement>('[data-next]');
    const dotsEl = root.querySelector<HTMLElement>('[data-dots]');
    if (!carousel || !track) return;

    const slides = Array.from(track.children) as HTMLElement[];
    if (!slides.length) return;

    carousel.hidden = false;

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const multi = slides.length > 1;
    let active = 0;

    carousel.setAttribute('role', 'region');
    carousel.setAttribute('aria-roledescription', 'carousel');
    carousel.setAttribute('aria-label', 'Recensioni Google');
    slides.forEach((slide, i) => {
      slide.setAttribute('role', 'group');
      slide.setAttribute('aria-roledescription', 'recensione');
      slide.setAttribute('aria-label', `Recensione ${i + 1} di ${slides.length}`);
    });

    if (!multi) {
      slides[0].classList.add('is-active');
      return;
    }

    if (nav) nav.hidden = false;

    // Puntini: uno per recensione, area di tocco da 44px
    const dots = slides.map((_, i) => {
      const dot = document.createElement('button');
      dot.type = 'button';
      dot.className = 'reviews-carousel__dot';
      dot.setAttribute('aria-label', `Vai alla recensione ${i + 1} di ${slides.length}`);
      dot.addEventListener(
        'click',
        () => {
          goTo(i);
          restart();
        },
        { signal },
      );
      return dot;
    });
    dotsEl?.replaceChildren(...dots);

    const update = () => {
      slides.forEach((slide, i) => {
        slide.classList.toggle('is-active', i === active);
        slide.inert = i !== active;
      });
      dots.forEach((dot, i) => {
        if (i === active) dot.setAttribute('aria-current', 'true');
        else dot.removeAttribute('aria-current');
      });
    };

    let settling = false;
    let settleTimer = 0;
    // Dall'ultima si torna alla prima (e viceversa)
    const goTo = (index: number) => {
      active = (index + slides.length) % slides.length;
      settling = true;
      window.clearTimeout(settleTimer);
      settleTimer = window.setTimeout(() => (settling = false), 700);
      slides[active].scrollIntoView({
        behavior: reduceMotion.matches ? 'instant' : 'smooth',
        inline: 'start',
        block: 'nearest',
      });
      update();
    };

    // --- Cambio automatico ---------------------------------------------------
    const interval = Number(root.dataset.autoplay);
    const autoplay = interval > 0 && !reduceMotion.matches;
    let timer = 0;
    let hovering = false;
    let onScreen = true;

    const canRun = () => !hovering && onScreen && !document.hidden && !carousel.querySelector(':focus-visible');

    // Ogni azione dell'utente azzera il conto alla rovescia
    function restart() {
      window.clearInterval(timer);
      if (autoplay) {
        timer = window.setInterval(() => {
          if (canRun()) goTo(active + 1);
        }, interval);
      }
    }

    prevBtn?.addEventListener(
      'click',
      () => {
        goTo(active - 1);
        restart();
      },
      { signal },
    );
    nextBtn?.addEventListener(
      'click',
      () => {
        goTo(active + 1);
        restart();
      },
      { signal },
    );

    carousel.addEventListener(
      'keydown',
      (event) => {
        const target =
          event.key === 'ArrowRight'
            ? active + 1
            : event.key === 'ArrowLeft'
              ? active - 1
              : event.key === 'Home'
                ? 0
                : event.key === 'End'
                  ? slides.length - 1
                  : null;
        if (target === null) return;
        event.preventDefault();
        goTo(target);
        restart();
      },
      { signal },
    );

    if (autoplay) {
      // Mouse sopra: ferma; il touch azzera solo il conto alla rovescia
      carousel.addEventListener('pointerenter', (e) => (hovering = e.pointerType === 'mouse'), { signal });
      carousel.addEventListener(
        'pointerleave',
        () => {
          hovering = false;
          restart();
        },
        { signal },
      );
      carousel.addEventListener('pointerdown', restart, { signal });
      carousel.addEventListener('focusout', restart, { signal });
      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver(([entry]) => (onScreen = entry.isIntersecting), { threshold: 0.4 });
        observer.observe(carousel);
        signal.addEventListener('abort', () => observer.disconnect());
      }
      signal.addEventListener('abort', () => window.clearInterval(timer));
    }

    // Segue lo swipe / scorrimento manuale: la posizione attiva rincorre la slide visibile
    let frame = 0;
    track.addEventListener(
      'scroll',
      () => {
        if (settling) return;
        cancelAnimationFrame(frame);
        frame = requestAnimationFrame(() => {
          const trackLeft = track.getBoundingClientRect().left;
          let closest = 0;
          let closestDistance = Infinity;
          slides.forEach((slide, i) => {
            const distance = Math.abs(slide.getBoundingClientRect().left - trackLeft);
            if (distance < closestDistance) {
              closestDistance = distance;
              closest = i;
            }
          });
          if (closest !== active) {
            active = closest;
            update();
            restart();
          }
        });
      },
      { passive: true, signal },
    );

    // Se cambia la larghezza (rotazione, resize) resta allineata alla slide attiva
    let resizeTimer = 0;
    window.addEventListener(
      'resize',
      () => {
        window.clearTimeout(resizeTimer);
        resizeTimer = window.setTimeout(() => {
          slides[active]?.scrollIntoView({ inline: 'start', block: 'nearest', behavior: 'instant' });
        }, 120);
      },
      { signal },
    );

    update();
    restart();
  }

  function renderReviews(root: HTMLElement, reviews: GoogleReview[], limit?: number): boolean {
    const track = root.querySelector<HTMLElement>('[data-track]');
    if (!track) return false;

    const items = limit ? reviews.slice(0, limit) : reviews;
    if (!items.length) return false;

    const replacing = track.children.length > 0;
    track.innerHTML = items.map(reviewMarkup).join('');
    if (!replacing) bindOriginalToggle(track);
    setupCarousel(root);
    return true;
  }

  async function init(root: HTMLElement): Promise<void> {
    const limitAttr = Number(root.dataset.limit);
    const limit = Number.isFinite(limitAttr) && limitAttr > 0 ? limitAttr : undefined;

    // Recensioni inserite a mano (già nel markup): il carosello parte subito
    const track = root.querySelector<HTMLElement>('[data-track]');
    if (track?.children.length) {
      bindOriginalToggle(track);
      setupCarousel(root);
    }

    // Se qualcosa non va (hosting senza PHP, chiave mancante, timeout…) non cambia nulla:
    // restano le recensioni inserite a mano, o il riquadro con i due link a Google.
    try {
      const controller = new AbortController();
      const timeoutId = setTimeout(() => controller.abort(), 8000);
      const response = await fetch('/api/google-reviews.php', {
        signal: controller.signal,
        headers: { Accept: 'application/json' },
      });
      clearTimeout(timeoutId);

      if (!response.ok) return;
      const data: GoogleReviewsPayload = await response.json();
      if (!data || data.available !== true) return;

      renderSummary(root, data);
      const hasReviews = renderReviews(root, Array.isArray(data.reviews) ? data.reviews : [], limit);
      const more = root.querySelector<HTMLElement>('[data-google-reviews-more]');
      if (hasReviews && more) more.hidden = false;
    } catch {
      /* niente da fare: resta il riquadro statico */
    }
  }

  document.querySelectorAll<HTMLElement>('[data-google-reviews]').forEach((root) => {
    void init(root);
  });
</script>

<style>
  /*
   * Blocco valutazione: un riquadro editoriale a sé stante (sfondo sabbia,
   * come le altre superfici "quiete" del sito), non una card di statistiche.
   * Colori sempre quelli "chiari": il riquadro resta leggibile identico sia
   * su sezioni chiare sia sulla sezione scura della homepage.
   */
  .reviews-rating {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem 2rem;
    padding: clamp(1.5rem, 1.2rem + 1.2vw, 2.25rem) clamp(1.5rem, 1.2rem + 2vw, 2.5rem);
    border-radius: var(--radius-l);
    background: var(--color-bg-sand);
  }

  /* Il testo fisso e la valutazione live occupano lo stesso spazio: niente salti di layout */
  .reviews-rating__main {
    display: grid;
    flex: 1 1 18rem;
    gap: 0.6rem;
    max-width: 34rem;
  }

  .reviews-rating__info {
    min-height: 5.25rem;
  }

  .reviews-rating__intro {
    margin: 0;
    color: var(--color-text);
  }

  .reviews-rating__actions {
    flex: none;
  }

  /*
   * Attribution testuale "Google Maps" (in alternativa al logo, ammessa quando
   * lo spazio è limitato). Requisiti verificati: testo esatto "Google Maps",
   * peso 400, corpo 12–16px, colore tra bianco/nero/#1F1F1F/#5E5E5E con
   * contrasto ≥ 4.5:1. Usiamo il font body del sito (non Roboto, per non
   * introdurre una famiglia tipografica in più solo per questa etichetta):
   * dimensione, peso e colore restano quelli richiesti.
   */
  :global(.reviews-rating__badge) {
    display: inline-flex;
    align-items: center;
    justify-self: start;
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
    background: var(--color-surface);
    color: #1f1f1f;
    font-family: var(--font-body);
    font-size: var(--text-label);
    font-weight: 400;
    letter-spacing: 0.01em;
  }

  :global(.reviews-rating__headline) {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  :global(.reviews-rating__number) {
    font-family: var(--font-heading);
    font-size: clamp(2.5rem, 1.9rem + 2.6vw, 3.75rem);
    font-weight: 600;
    line-height: 1;
    color: var(--color-primary-dark);
  }

  :global(.reviews-rating__stars) {
    display: inline-flex;
    gap: 0.2rem;
    color: var(--color-accent);
  }

