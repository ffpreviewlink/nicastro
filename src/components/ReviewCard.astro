---
/**
 * Recensione Google. Senza dati mostra un segnaposto esplicito: non simula mai
 * una recensione, un nome o una valutazione.
 */
import Icon from './Icon.astro';
import Fill from './Fill.astro';
import type { Review } from '../data/reviews';

interface Props {
  review?: Review;
}

const { review } = Astro.props;
---

{
  review ? (
    <figure class="review">
      <p class="review__stars" role="img" aria-label={`${review.rating} stelle su 5`}>
        {Array.from({ length: review.rating }, () => (
          <Icon name="star" />
        ))}
      </p>
      <blockquote class="review__text">
        <p>{review.text}</p>
      </blockquote>
      <figcaption class="review__author">
        <strong>{review.author}</strong>
        <span>Recensione su Google{review.date ? ` · ${review.date}` : ''}</span>
      </figcaption>
    </figure>
  ) : (
    <figure class="review review--empty" data-placeholder>
      <blockquote class="review__text">
        <p>
          <Fill value="[RECENSIONE GOOGLE DA INSERIRE]" />
        </p>
      </blockquote>
      <figcaption class="review__author">
        <strong>
          <Fill value="[NOME COME APPARE SU GOOGLE]" />
        </strong>
        <span>Qui comparirà una recensione reale</span>
      </figcaption>
    </figure>
  )
}

<style>
  .review {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.75rem 1.5rem;
    border-radius: var(--radius-l);
    background: var(--color-surface);
    color: var(--color-text);
    break-inside: avoid;
  }

  .review--empty {
    border: 2px dashed var(--color-border-strong);
    background: var(--color-bg-sand);
  }

  .review__stars {
    display: flex;
    gap: 0.2rem;
    color: var(--color-accent);
  }

  .review__stars :global(svg) {
    width: 1.15rem;
    height: 1.15rem;
  }

  .review__text {
    margin: 0;
    flex: 1;
    font-size: 1.0625rem;
    line-height: 1.6;
  }

  .review__author {
    display: grid;
    gap: 0.1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
    font-size: var(--text-small);
    color: var(--color-text-muted);
  }

  .review__author strong {
    font-family: var(--font-heading);
    font-size: 0.9375rem;
    color: var(--color-text);
  }
</style>
