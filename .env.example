# Chiave server-side per Google Places API (New), usata solo da
# public/api/google-reviews.php. NON deve mai avere il prefisso PUBLIC_
# e non deve mai finire in JavaScript o HTML lato client.
#
# Questo file è solo un esempio (nessun valore reale). Il file vero (.env,
# con la chiave reale) va creato direttamente sul server Aruba dentro
# htdocs/api/ e non va MAI committato: vedi README per la procedura.
GOOGLE_PLACES_API_KEY=

# --- Modulo contatti (public/api/contact.php) -------------------------------------
# Stesso file .env sul server (htdocs/api/.env). Il mittente deve essere una casella
# reale del dominio, creata dal pannello Aruba.
SMTP_USER=
SMTP_PASSWORD=
# Facoltativi (valori di default tra parentesi)
# MAIL_TO=        (default: SMTP_USER, cioè i messaggi arrivano nella casella info@)
# SMTP_HOST=smtps.aruba.it
# SMTP_PORT=465
# SMTP_SECURE=ssl   (ssl oppure starttls; default: ssl sulla 465)
# MAIL_FROM=      (default: SMTP_USER)
# MAIL_FROM_NAME= (default: Sito Studio Optometrico Nicastro)
